#!/usr/bin/env python3
"""Copy local files to this host using ropen's automatic reverse SSH tunnel."""
import argparse
from pathlib import Path
import runpy
import signal
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(
        description='Copy a file from the connected local computer to this host; reverse ports are allocated automatically.',
        epilog="Quote ~/ paths, e.g. rscp '~/Downloads/file.pdf' . or "
               "rscp -r '~/Downloads/my folder' ./. Run ropen login to install the key. "
               'Overrides: ROPEN_USER, ROPEN_CONTROL; ROPEN_PORT/ROPEN_HOST for a manual tunnel.')
    parser.add_argument('-r', action='store_true', help='copy a directory recursively')
    parser.add_argument('local_path')
    parser.add_argument('host_path')
    args = parser.parse_args()

    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)

    ropen = runpy.run_path(str(Path(__file__).resolve().with_name('ropen')))
    # Always interpret the destination as a path on this host, including ':'.
    destination = args.host_path
    if not destination.startswith('/'):
        destination = './' + destination
    with ropen['tunnel']() as (port, identity):
        command = ropen['transfer_command'](port, identity, program='scp')
        target = command.pop()
        if args.r:
            command.append('-r')
        command += ['--', target + ':' + args.local_path, destination]
        return subprocess.run(command).returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print('rscp: ' + str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
