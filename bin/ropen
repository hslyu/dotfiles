#!/usr/bin/env python3
"""Copy/open remote files through an automatically allocated reverse SSH port."""
import argparse
import contextlib
import fcntl
import hashlib
import os
from pathlib import Path
import re
import shlex
import signal
import stat
import subprocess
import sys
import time

CONTROL = re.compile(r"/tmp/ropen-control-[^/\s]+-[a-f0-9]{40}\.sock")
SSH_NAMES = {"ssh", "sshd", "sshd-session"}
MASTER = "/tmp/ropen-master-%r-%C.sock"
FORWARD = "/tmp/ropen-control-%r-%C.sock:" + MASTER
FORWARD_SPEC = "127.0.0.1:0:localhost:22"


def die(message):
    raise RuntimeError(message)


def process(pid):
    """Return identity including start time so a recycled PID cannot be killed."""
    try:
        p = Path('/proc') / str(pid)
        fields = (p / 'stat').read_text().rpartition(') ')[2].split()
        return dict(pid=pid, uid=p.stat().st_uid,
                    name=(p / 'comm').read_text().strip(),
                    parent=int(fields[1]), start=fields[19])
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return None


def ssh_ancestor(pid):
    seen = set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        p = process(pid)
        if p is None:
            break
        if p['uid'] == os.getuid() and p['name'] in {'sshd', 'sshd-session'}:
            return pid
        pid = p['parent']
    return None


def current_session():
    # tmux's original server ancestor can belong to an old SSH connection.
    if os.environ.get('TMUX') and os.environ.get('TMUX_PANE'):
        result = subprocess.run(
            ['tmux', 'list-clients', '-t', os.environ['TMUX_PANE'],
             '-F', '#{client_activity} #{client_pid}'],
            capture_output=True, text=True, timeout=5)
        clients = [tuple(map(int, line.split())) for line in result.stdout.splitlines()
                   if re.fullmatch(r'\d+ \d+', line)]
        for _, pid in sorted(clients, reverse=True):
            current = ssh_ancestor(pid)
            if current:
                return current
    return ssh_ancestor(os.getpid())


def listeners():
    if not Path('/proc').is_dir():
        die('server-side tunnel discovery/reset requires Linux')
    # The sshd privilege separation process hides its sockets from ordinary ss.
    result = subprocess.run(['sudo', '-n', 'ss', '-H', '-ltnxp'],
                            capture_output=True, text=True, timeout=10)
    if result.returncode:
        die('cannot inspect SSH forwarding listeners (sudo -n ss is required)')
    rows = []
    for line in result.stdout.splitlines():
        for pid in {int(p) for p in re.findall(r'pid=(\d+)', line)}:
            p = process(pid)
            if p and p['uid'] == os.getuid() and p['name'] in SSH_NAMES:
                rows.append((p, line))
    return rows


def control_socket():
    rows = listeners()
    sockets = {}
    for p, line in rows:
        for path in CONTROL.findall(line):
            try:
                st = Path(path).stat()
                if st.st_uid == os.getuid() and stat.S_ISSOCK(st.st_mode):
                    sockets[path] = p['pid']
            except FileNotFoundError:
                pass
    current = current_session()
    selected = [path for path, pid in sockets.items() if pid == current]
    explicit = os.environ.get('ROPEN_CONTROL')
    if explicit:
        if explicit not in sockets:
            die('ROPEN_CONTROL is not a live SSH control channel owned by this account')
        return explicit
    if len(selected) == 1:
        return selected[0]
    # Detached Codex / VS Code sessions may not descend from the new connection.
    # A single connected client is safe; never pick an arbitrary one of several.
    if not selected and len(sockets) == 1:
        return next(iter(sockets))
    if sockets:
        die('multiple client connections; run in the attached SSH/tmux session '
            'or select its socket with ROPEN_CONTROL')
    die('no ropen control channel; reconnect once using ssh with the updated '
        'config, or: ropen ssh <server>')


def mux(control, action):
    return subprocess.run(
        ['ssh', '-F', '/dev/null', '-S', control, '-O', action,
         '-R', FORWARD_SPEC, 'localhost'],
        capture_output=True, text=True, timeout=15)


@contextlib.contextmanager
def tunnel():
    explicit = os.environ.get('ROPEN_PORT')
    if explicit:
        if not explicit.isascii() or not explicit.isdigit() or not 1 <= int(explicit) <= 65535:
            die('invalid ROPEN_PORT')
        yield int(explicit), 'manual-' + os.environ.get('ROPEN_HOST', 'localhost')
        return
    control = control_socket()
    ssh_dir = Path.home() / '.ssh'
    ssh_dir.mkdir(mode=0o700, exist_ok=True)
    identity = hashlib.sha256(control.encode()).hexdigest()[:24]
    # OpenSSH reuses identical -R 0 requests. Serialize allocation + transfer +
    # cancellation so simultaneous ropen calls cannot cancel one another.
    lock = ssh_dir / ('ropen-' + identity + '.lock')
    fd = os.open(str(lock), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'r+') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        result = mux(control, 'forward')
        port = result.stdout.strip()
        if result.returncode or not port.isdigit() or not 1 <= int(port) <= 65535:
            die('cannot allocate a reverse port: ' + result.stderr.strip())
        try:
            yield int(port), identity
        finally:
            result = mux(control, 'cancel')
            if result.returncode:
                print('ropen: could not cancel the temporary tunnel: ' +
                      result.stderr.strip(), file=sys.stderr)


def key_pair(create=False):
    for name in ('id_ed25519', 'id_rsa'):
        key = Path.home() / '.ssh' / name
        if key.is_file() and key.with_suffix('.pub').is_file():
            return key
    if create:
        directory = Path.home() / '.ssh'
        directory.mkdir(mode=0o700, exist_ok=True)
        key = directory / 'id_ed25519'
        # Do not overwrite a private key whose public key was removed.
        if key.exists():
            result = subprocess.check_output(['ssh-keygen', '-y', '-f', str(key)])
            key.with_suffix('.pub').write_bytes(result)
        else:
            subprocess.run(['ssh-keygen', '-t', 'ed25519', '-N', '', '-f', str(key),
                            '-C', 'ropen'], check=True)
        return key
    return None


def transfer_command(port, identity, program='ssh'):
    host = os.environ.get('ROPEN_HOST', 'localhost')
    if program == 'scp' and ':' in host and not host.startswith('['):
        host = '[' + host + ']'
    target = (os.environ['ROPEN_USER'] + '@' if os.environ.get('ROPEN_USER') else '') + host
    command = [program, '-F', '/dev/null', '-P' if program == 'scp' else '-p', str(port),
               '-o', 'ConnectTimeout=8', '-o', 'ServerAliveInterval=15',
               '-o', 'ServerAliveCountMax=2', '-o', 'ControlMaster=no',
               '-o', 'ControlPath=none', '-o', 'IdentitiesOnly=yes',
               '-o', 'StrictHostKeyChecking=accept-new',
               '-o', 'HostKeyAlias=ropen-' + identity,
               '-o', 'UserKnownHostsFile=' + str(Path.home() / '.ssh/ropen_known_hosts')]
    key = key_pair()
    if key:
        command += ['-i', str(key)]
    return command + [target]


OPEN_SCRIPT = r'''
set -eu
destination="$HOME/Downloads"
if [ "$ROPEN_MKDIR" = 1 ]; then mkdir -p "$destination"; fi
[ -d "$destination" ] || { echo "ropen: no Downloads directory" >&2; exit 1; }
file="$destination/$ROPEN_BASE"
cat > "$file"
if [ "$ROPEN_OPEN" = 0 ]; then
    printf 'saved %s\n' "$file"
elif [ "$(uname -s)" = Darwin ]; then
    open "$file"
    printf 'requested open %s\n' "$file"
else
    desktop_env="$(systemctl --user show-environment 2>/dev/null || true)"
    while IFS= read -r entry; do
        case "$entry" in
            DISPLAY=*|WAYLAND_DISPLAY=*|XAUTHORITY=*|XDG_RUNTIME_DIR=*|DBUS_SESSION_BUS_ADDRESS=*|XDG_CURRENT_DESKTOP=*) export "$entry" ;;
        esac
    done <<ROPEN_DESKTOP_ENV
$desktop_env
ROPEN_DESKTOP_ENV
    if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        echo "ropen: saved $file, but no local desktop session was found" >&2
        exit 1
    fi
    open_log="$(mktemp "${TMPDIR:-/tmp}/ropen-open.XXXXXX")"
    if ! xdg-open "$file" </dev/null >"$open_log" 2>&1; then
        cat "$open_log" >&2
        exit 1
    fi
    printf 'requested open %s (log: %s)\n' "$file" "$open_log"
fi
'''


def open_file(args):
    path = Path(args.file).resolve()
    if not path.is_file():
        die('file not found or not a regular file: ' + args.file)
    env = dict(ROPEN_BASE=path.name, ROPEN_MKDIR=str(int(not args.no_mkdir)),
               ROPEN_OPEN=str(int(not args.no_open)))
    command = ' '.join(k + '=' + shlex.quote(v) for k, v in env.items())
    command += ' sh -c ' + shlex.quote(OPEN_SCRIPT)
    with tunnel() as (port, identity), path.open('rb') as handle:
        result = subprocess.run(transfer_command(port, identity) + [command], stdin=handle)
        if result.returncode:
            die('could not save/open ' + path.name + '; check local Remote Login and run ropen login if needed')


def login():
    key = key_pair(create=True)
    script = r'''
set -eu
key=$(cat)
mkdir -p "$HOME/.ssh"
auth="$HOME/.ssh/authorized_keys"
touch "$auth"
grep -qxF "$key" "$auth" || printf '%s\n' "$key" >> "$auth"
chmod 700 "$HOME/.ssh"
chmod 600 "$auth"
printf 'installed ropen key in %s\n' "$auth"
'''
    with tunnel() as (port, identity), key.with_suffix('.pub').open('rb') as handle:
        subprocess.run(transfer_command(port, identity) + ['sh -c ' + shlex.quote(script)],
                       stdin=handle, check=True)


def connect_ssh(args):
    if not args:
        die('ssh requires a destination')
    # Avoid adding the same control forwarding twice when plain SSH is configured.
    config = subprocess.run(['ssh', '-G'] + args, capture_output=True, text=True, check=True).stdout
    options = ['ssh', '-o', 'ControlMaster=auto', '-o', 'ControlPersist=60',
               '-o', 'ControlPath=' + MASTER,
               '-o', 'ServerAliveInterval=30', '-o', 'ServerAliveCountMax=3']
    if not any(line.startswith('remoteforward ') and '/tmp/ropen-control-' in line
               for line in config.splitlines()):
        options += ['-R', FORWARD]
    os.execvp('ssh', options + args)


def reset_targets(rows):
    """Only SSH transport processes owning listeners, never application servers."""
    targets = {}
    for p, _ in rows:
        if p['uid'] == os.getuid() and p['name'] in SSH_NAMES:
            targets[p['pid']] = p
    # Outgoing reverse forwards need not have any local listening socket.
    for path in Path('/proc').glob('[0-9]*/cmdline'):
        p = process(int(path.parent.name))
        if not p or p['uid'] != os.getuid() or p['name'] != 'ssh':
            continue
        try:
            args = path.read_bytes().decode(errors='replace').split('\0')[1:]
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        if any(a.startswith(('-R', '-L', '-D')) or 'RemoteForward=' in a
               or 'LocalForward=' in a or 'DynamicForward=' in a for a in args):
            targets[p['pid']] = p
    return list(targets.values())


def stop_targets(targets):
    for expected in targets:
        if process(expected['pid']) == expected:
            with contextlib.suppress(ProcessLookupError):
                os.kill(expected['pid'], signal.SIGTERM)


def reset(dry_run):
    targets = reset_targets(listeners())
    for p in targets:
        print('ropen: {} forwarding SSH connection PID {} ({})'.format(
            'would stop' if dry_run else 'stopping', p['pid'], p['name']))
    if not targets:
        print('ropen: no SSH forwarding connections for this account')
    if dry_run or not targets:
        return
    print('ropen: all listed SSH forwards will close; their login sessions may disconnect', flush=True)
    # Complete cleanup even when the command's own SSH transport is a target.
    worker = ('import runpy, time; '
              'm=runpy.run_path(' + repr(str(Path(__file__).resolve())) + '); '
              'time.sleep(0.5); m["stop_targets"](' + repr(targets) + ')')
    subprocess.Popen([sys.executable, '-c', worker], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    # Unwind the tunnel context on terminal disconnect/termination as well.
    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    if len(sys.argv) > 1 and sys.argv[1] == 'ssh':
        connect_ssh(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] == 'reset':
        parser = argparse.ArgumentParser(prog='ropen reset', description='Close this account\'s SSH forwarding connections (login sessions may disconnect).')
        parser.add_argument('--dry-run', action='store_true', help='list affected SSH connections without stopping them')
        reset(parser.parse_args(sys.argv[2:]).dry_run)
        return
    if len(sys.argv) > 1 and sys.argv[1] == 'clear':
        die('clear has been removed; tunnels are automatic. Use ropen reset to close all SSH forwarding connections')
    if len(sys.argv) > 1 and sys.argv[1] in ('login', '--install-key'):
        if len(sys.argv) != 2:
            die('login does not accept arguments')
        login()
        return
    parser = argparse.ArgumentParser(description='Copy a remote file to the connected local computer; reverse ports are allocated automatically.',
                                    epilog='Other commands: ropen ssh [SSH_OPTIONS] DESTINATION; ropen login; ropen reset [--dry-run]. '
                                    'Overrides: ROPEN_USER, ROPEN_CONTROL; ROPEN_PORT/ROPEN_HOST for a manual tunnel.')
    parser.add_argument('--no-mkdir', action='store_true')
    parser.add_argument('-n', '--no-open', action='store_true', help='save to local Downloads without opening')
    parser.add_argument('file')
    open_file(parser.parse_args())


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print('ropen: ' + str(error), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
