#!/usr/bin/env bash

set -euo pipefail

personal_codex_home="${CODEX_PERSONAL_HOME:-$HOME/.codex-personal}"
mkdir -p "$personal_codex_home"

launcher_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$launcher_dir/codex-fallback" ]]; then
  exec env CODEX_HOME="$personal_codex_home" "$launcher_dir/codex-fallback" "$@"
fi
exec env CODEX_HOME="$personal_codex_home" "$HOME/.local/bin/codex-fallback" "$@"
